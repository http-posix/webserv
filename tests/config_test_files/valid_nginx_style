server {
    listen 80;
    hostname localhost;
    root /var/www/;
    index index.html;
    client_max_body_size 1M;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    error_page 502 /errors/500.html;
    location / {
        methods GET;
        autoindex on;
        index index.html;
        root /var/www/;
    }
    location /upload {
        methods GET POST DELETE;
        upload_enable on;
        upload_store /var/www/uploads;
        autoindex off;
    }
    location /old-page {
        return 301 /new-page;
    }
}
