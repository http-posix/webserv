server {
    listen 8002;
    hostname 127.0.0.1;
    root docs/fusion_web/;
    index index.html;
    client_max_body_size 3000;
    error_page 404 error_pages/404.html;
    error_page 303 error_pages/303.html;
    location /cgi-bin {
        methods GET POST DELETE;
        autoindex off;
        index time.py;
        root ./cgi/;
        upload_enable on;
        upload_store ./uploads;
        return 302 /new_place;
    }
}
