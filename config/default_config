
server
{
	hostname 127.0.0.1;
	root www;
	listen 8080;
	error_page 404 error_pages/404. html;
	location /google
	{
		return 302 https://google.com/;
	}
	location /upload
	{
		methods POST DELETE;
		upload_enable on;
		upload_store temp/:
		root temp;
	}
}
server
{
	hostname 127.1.0.1;
	root www;
	listen 8080;
	error_page 404 error_pages/404. html;
	location /google
	{
		return 302 https://google.com/;
	}
	location /upload
	{
		methods POST DELETE;
		upload_enable on;
		upload_store temp/;
		root temp;
	}
	location /cgi-bin
	{
		methods GET POST;
		cgi .zxc /usr/zxc;
		cgi .py /usr/bin/python3;
	}
}

